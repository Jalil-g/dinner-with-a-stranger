# Copy to .env and adjust. Never commit the real .env.
DATABASE_URL="postgresql://dws:dws@localhost:5433/dws?schema=public"
PORT=5174
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173
# Number of reverse proxies in front of the API (set to 1 on Render/Fly/Railway)
TRUST_PROXY=0
# Max signup requests per IP per 15 minutes
SUBMIT_RATE_LIMIT=20
